# Get these two from https://my.telegram.org -> API Development Tools
TG_API_ID=
TG_API_HASH=

# Your Telegram phone number, international format
TG_PHONE=

# Channel username (without @), whose videos get listed
TG_CHANNEL=sm1523

# Filled in automatically after you run "npm run login" once
TG_SESSION=

# How many recent messages to scan per sync
TG_FETCH_LIMIT=2000

# Cron schedule for auto re-sync (default: every 6 hours)
SYNC_CRON=0 */6 * * *

# Secret query key to protect POST /api/sync, e.g. ?key=... . Set to any random string.
ADMIN_KEY=

PORT=3000
